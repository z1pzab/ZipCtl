# Maintainer: z1pzab <https://github.com/z1pzab/ZipCtl>
pkgname=zipctl
pkgver=0.2.0
pkgrel=1
pkgdesc="Лёгкий кроссплатформенный TUI-центр управления системой, Git-проектами, сервисами и AI-харнессами"
arch=('x86_64' 'aarch64')
url="https://github.com/z1pzab/ZipCtl"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=(
    'wl-clipboard: копирование заметки HANDOFF в буфер Wayland (wl-copy)'
    'xclip: копирование заметки HANDOFF в буфер X11'
    'pacman-contrib: очистка кэша пакетов Arch через paccache -rk1'
    'xdg-utils: открытие веб-чатов и каталогов проектов'
    'yay: установка недостающих AUR-харнессов после подтверждения'
)
options=('!lto')

build() {
    local _src_root="${startdir}/.."
    if [[ ! -f "${_src_root}/Cargo.toml" ]]; then
        _src_root="${startdir}"
    fi
    cd "${_src_root}"
    export CARGO_TARGET_DIR="${srcdir}/target"
    cargo build --release
}

package() {
    local _src_root="${startdir}/.."
    if [[ ! -f "${_src_root}/Cargo.toml" ]]; then
        _src_root="${startdir}"
    fi
    install -Dm755 "${srcdir}/target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
    if [[ -f "${_src_root}/README.md" ]]; then
        install -Dm644 "${_src_root}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
    if [[ -f "${_src_root}/LICENSE" ]]; then
        install -Dm644 "${_src_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
